# Copia este archivo como .env.local y completa los valores.
# Sin Supabase la tienda funciona en modo demo (catálogo local y pedidos por WhatsApp).

# URL pública de la tienda (en Vercel: https://fiden.ec)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Número de WhatsApp de la tienda, con código de país y sin "+"
NEXT_PUBLIC_WHATSAPP=593990000000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Payphone → Developer → tu aplicación (deja vacío para ocultar el pago con tarjeta)
PAYPHONE_TOKEN=
PAYPHONE_STORE_ID=
